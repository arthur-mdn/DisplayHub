DB_URI=mongodb://DisplayHub-mongodb:27017/DisplayHub
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
OPEN_WEATHER_API_KEY=A_VALID_OPEN_WEATHER_API_KEY

VITE_SCHEME=http
VITE_SERVER_URL=localhost:3003
VITE_CLIENT_URL=localhost:5173
VITE_ADMIN_URL=localhost:5174
VITE_VITRINE_URL=localhost:5175

VITE_SERVER_PORT=3003
VITE_CLIENT_PORT=5173
VITE_ADMIN_PORT=5174
VITE_VITRINE_PORT=5175

COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
VITE_COOKIE_DOMAIN=localhost

PI_SERVER_PORT=3002
PI_API_TOKEN=REPLACE_WITH_PI_API_TOKEN
VITE_PI_SERVER_URL=http://127.0.0.1:3002
# Optional on the Pi device only: localStorage.setItem('piApiToken', '...')
# Do not put the Pi token in VITE_* variables (they are public).

# Production Mongo auth (docker-compose.prod.yml)
MONGO_ROOT_USER=displayhub
MONGO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MONGODB_PORT=27017
MONGODB_HOST_PORT=27019
