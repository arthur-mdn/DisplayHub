FROM node:20 as build
WORKDIR /app

ARG VITE_SCHEME
ARG VITE_CLIENT_URL
ARG VITE_SERVER_URL
ARG VITE_ADMIN_URL
ARG VITE_COOKIE_DOMAIN
ARG VITE_PI_SERVER_URL
ARG VITE_PI_API_TOKEN

ENV VITE_SCHEME=$VITE_SCHEME \
    VITE_CLIENT_URL=$VITE_CLIENT_URL \
    VITE_SERVER_URL=$VITE_SERVER_URL \
    VITE_ADMIN_URL=$VITE_ADMIN_URL \
    VITE_COOKIE_DOMAIN=$VITE_COOKIE_DOMAIN \
    VITE_PI_SERVER_URL=$VITE_PI_SERVER_URL \
    VITE_PI_API_TOKEN=$VITE_PI_API_TOKEN

COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
